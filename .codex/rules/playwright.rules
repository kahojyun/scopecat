# Allow this project's Playwright test entry points to run outside the sandbox.
prefix_rule(
    pattern = ["pnpm", "exec", "playwright", "test"],
    decision = "allow",
    justification = "Run the project's Playwright end-to-end tests",
    match = [
        "pnpm exec playwright test",
        "pnpm exec playwright test tests/config-workspace.spec.ts",
        "pnpm exec playwright test --project=chromium",
    ],
    not_match = [
        "pnpm exec playwright install chromium",
        "pnpm exec playwright codegen",
    ],
)

prefix_rule(
    pattern = ["pnpm", "run", "test:e2e"],
    decision = "allow",
    justification = "Build the UI and run its Playwright end-to-end test suite",
    match = [
        "pnpm run test:e2e",
        "pnpm run test:e2e -- --project=chromium",
    ],
    not_match = [
        "pnpm run test:e2e:install",
    ],
)

prefix_rule(
    pattern = ["pnpm", "test:e2e"],
    decision = "allow",
    justification = "Run the project's Playwright end-to-end test script via pnpm shorthand",
    match = [
        "pnpm test:e2e",
        "pnpm test:e2e -- --project=chromium",
    ],
    not_match = [
        "pnpm test:e2e:install",
    ],
)
