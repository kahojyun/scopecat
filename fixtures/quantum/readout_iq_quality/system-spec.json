  "device_under_test_id": "example-readout-device",
  "device_topology": {
    "devices": [
      {
        "id": "q0",
        "kind": "logical_qubit",
        "channels": [
          "readout-q0"
        ],
        "metadata": {
          "device_role": "readout subject"
        }
      }
    ],
    "links": [],
    "channels": [
      {
        "id": "readout-q0",
        "kind": "readout",
        "device_id": "q0",
        "direction": "readout"
      }
    ]
  },
  "instrument_registry": {
    "instruments": [
      {
        "id": "readout-stack",
        "kind": "awg_adc",
        "channels": [
          "readout-q0"
        ],
        "capabilities": [
          "prepare_state",
          "readout_pulse",
          "demodulate_iq",
          "capture_shots"
        ]
      }
    ]
  },
  "metadata": {
    "sample_reference": "sample-public://readout/iq-quality",
    "example_status": "synthetic role-based identifiers and offline resources",
    "adapter_goal": "analysis step design for shot-level readout quality diagnostics"
  },
  "parameter_catalog": {
    "schema_version": "scopecat.parameter_catalog.v1",
    "id": "example-readout-iq-parameter-definitions-catalog",
    "scalar_definitions": [
      {
        "id": "readout_frequency",
        "unit": "GHz",
        "safety_min": {
          "value": 5.7,
          "unit": "GHz"
        },
        "safety_max": {
          "value": 6.2,
          "unit": "GHz"
        },
        "description": "Readout frequency used for the IQ scatter sample."
      },
      {
        "id": "readout_power",
        "unit": "dBm",
        "safety_min": {
          "value": -45.0,
          "unit": "dBm"
        },
        "safety_max": {
          "value": -10.0,
          "unit": "dBm"
        },
        "description": "Fixed readout power for the IQ scatter sample."
      },
      {
        "id": "repetitions",
        "unit": "count",
        "safety_min": {
          "value": 1.0,
          "unit": "count"
        },
        "safety_max": {
          "value": 100000.0,
          "unit": "count"
        },
        "description": "Shot count used by the IQ scatter acquisition."
      }
    ],
