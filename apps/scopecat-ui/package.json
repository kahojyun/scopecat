{
  "name": "scopecat-ui",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:api": "uv run --project ../.. python scripts/export-openapi.py && json2ts -i .generated/ui-api.schema.json -o src/api-schema.d.ts",
    "check:api": "pnpm run generate:api && git diff --exit-code -- src/api-schema.d.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "pnpm run build && playwright test",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@tanstack/react-query": "5.101.2",
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "json-schema-to-typescript": "15.0.4",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
