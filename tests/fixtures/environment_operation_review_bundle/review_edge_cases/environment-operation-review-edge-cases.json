{
  "summary_id": "environment-operation-review-edge-cases.expected",
  "status": "expected_validation_output",
  "source_fixture": "../basic_operation_review/environment-operation-review-input.json",
  "reference_semantics": {
    "status": "fixture_only",
    "contract_guard": "Edge cases mutate explicit prior review-summary facts only; the bundle still does not execute uv, inspect filesystems, verify dependency sync, or claim runnable readiness.",
    "summary_policy": "review_summary",
    "artifact_boundary": "internal_validation_summary"
  },
  "cases": [
    {
      "case_id": "manifest_preflight_has_findings",
      "description": "A non-passing prior manifest preflight status plus carried child findings stays review-only.",
      "mutations": [
        {
          "path": [
            "modern_manifest_preflight_summary",
            "preflight_status"
          ],
          "value": "manifest_preflight_has_review_findings"
        },
        {
          "path": [
            "modern_manifest_preflight_summary",
            "preflight_findings"
          ],
          "value": [
            {
              "code": "declared_dependency_group_missing",
              "severity": "review",
              "basis": "Declared dependency group lab is absent.",
              "does_not_claim": "dependency_resolution_or_dependency_sync"
            }
          ]
        }
      ],
      "expected_operation_review_status": "operation_review_has_findings",
      "expected_finding_codes": [
        "manifest_preflight_not_passed",
        "manifest_preflight_has_findings"
      ]
    },
    {
      "case_id": "uv_sync_reported_failure",
      "description": "A declared failed external uv sync result remains an unverified review fact.",
      "mutations": [
        {
          "path": [
            "uv_sync_result_summary",
            "command_result",
            "execution_state"
          ],
          "value": "completed_failed"
        },
        {
          "path": [
            "uv_sync_result_summary",
            "command_result",
            "exit_code"
          ],
          "value": 1
        },
        {
          "path": [
            "uv_sync_result_summary",
            "result_status"
          ],
          "value": "external_sync_reported_failure"
        },
        {
          "path": [
            "uv_sync_result_summary",
            "result_findings"
          ],
          "value": [
            {
              "code": "uv_sync_reported_failure",
              "severity": "review",
              "basis": "External uv sync result reports a non-zero exit code.",
              "does_not_claim": "synchronized_or_installed_environment"
            }
          ]
        }
      ],
      "expected_operation_review_status": "operation_review_has_findings",
      "expected_finding_codes": [
        "uv_sync_result_has_findings",
        "uv_sync_result_not_success"
      ]
    },
    {
      "case_id": "uv_sync_not_run",
      "description": "A declared not-run external uv sync result does not become a run block or readiness claim.",
      "mutations": [
        {
          "path": [
            "uv_sync_result_summary",
            "command_result",
            "execution_state"
          ],
          "value": "not_run"
        },
        {
          "path": [
            "uv_sync_result_summary",
            "command_result",
            "exit_code"
          ],
          "value": null
        },
        {
          "path": [
            "uv_sync_result_summary",
            "result_status"
          ],
          "value": "external_sync_not_run"
        },
        {
          "path": [
            "uv_sync_result_summary",
            "result_findings"
          ],
          "value": [
            {
              "code": "uv_sync_not_run",
              "severity": "review",
              "basis": "External uv sync operation was not attempted.",
              "does_not_claim": "synchronized_or_installed_environment"
            }
          ]
        }
      ],
      "expected_operation_review_status": "operation_review_has_findings",
      "expected_finding_codes": [
        "uv_sync_result_has_findings",
        "uv_sync_result_not_success"
      ]
    },
    {
      "case_id": "uv_sync_command_mismatch",
      "description": "A deliberately inconsistent result projection with mismatched command facts is surfaced as bundle-level review alignment evidence.",
      "mutations": [
        {
          "path": [
            "uv_sync_result_summary",
            "command_result",
            "argv"
          ],
          "value": [
            "uv",
            "sync",
            "--locked"
          ]
        }
      ],
      "expected_operation_review_status": "operation_review_has_findings",
      "case_boundary": "bundle_alignment_guard_for_inconsistent_prior_projection",
      "expected_finding_codes": [
        "sync_result_command_mismatch"
      ]
    }
  ]
}
